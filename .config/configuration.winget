# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
# Maintained by the winget-config-maintainer agent from PRD.md. Change PRD.md, not this file.
# Apply on the PC: winget configure -f .config/configuration.winget
properties:
  assertions:
    - resource: Microsoft.Windows.Developer/OsVersion
      directives:
        description: "[SYS-01] Require Windows 11"
        allowPrerelease: true
      settings:
        MinVersion: "10.0.22000"
  resources:
    - resource: Microsoft.Windows.Developer/DeveloperMode
      directives:
        description: "[SYS-02] Turn on Developer Mode"
        securityContext: elevated
        allowPrerelease: true
      settings:
        Ensure: Present
    - resource: Microsoft.Windows.Developer/EnableLongPathSupport
      directives:
        description: "[SYS-03] Allow file paths over 260 characters"
        securityContext: elevated
        allowPrerelease: true
      settings:
        Ensure: Present
    - resource: Microsoft.Windows.Developer/PowerPlanSetting
      directives:
        description: "[SYS-04] Never sleep when plugged in (screen timeout stays at the Windows default)"
        securityContext: elevated
        allowPrerelease: true
      settings:
        Name: SleepTimeout
        PowerSource: PluggedIn
        SettingValue: 0
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-01, RUN-01] Install or upgrade Google Chrome"
        securityContext: elevated
      settings:
        id: Google.Chrome
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-02, RUN-01] Install or upgrade Visual Studio Code"
        securityContext: elevated
      settings:
        id: Microsoft.VisualStudioCode
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-03, RUN-01] Install or upgrade Git"
        securityContext: elevated
      settings:
        id: Git.Git
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-04, RUN-01] Install or upgrade uv"
        securityContext: elevated
      settings:
        id: astral-sh.uv
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-05, RUN-01] Install or upgrade Python 3.14"
        securityContext: elevated
      settings:
        id: Python.Python.3.14
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-06, RUN-01] Install or upgrade Node.js LTS"
        securityContext: elevated
      settings:
        id: OpenJS.NodeJS.LTS
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-07, RUN-01] Install or upgrade Bun"
        securityContext: elevated
      settings:
        id: Oven-sh.Bun
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-08, RUN-01] Install or upgrade Databricks CLI"
        securityContext: elevated
      settings:
        id: Databricks.DatabricksCLI
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      id: wsl
      directives:
        description: "[APP-09, RUN-01] Install or upgrade Windows Subsystem for Linux"
        securityContext: elevated
      settings:
        id: Microsoft.WSL
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      dependsOn:
        - wsl
      directives:
        description: "[APP-10] Install Ubuntu 24.04 LTS for WSL"
        securityContext: elevated
      settings:
        id: Canonical.Ubuntu.2404
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-11] Install Docker Desktop"
        securityContext: elevated
      settings:
        id: Docker.DockerDesktop
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-12] Install Steam"
        securityContext: elevated
      settings:
        id: Valve.Steam
        source: winget
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-13, RUN-01] Install or upgrade Battle.net"
        securityContext: elevated
      settings:
        id: Blizzard.BattleNet
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-14, RUN-01] Install or upgrade GOG GALAXY"
        securityContext: elevated
      settings:
        id: GOG.Galaxy
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-15, RUN-01] Install or upgrade Discord"
        securityContext: elevated
      settings:
        id: Discord.Discord
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-16, RUN-01] Install or upgrade WhatsApp"
        securityContext: elevated
      settings:
        id: 9NKSQGP7F2NH
        source: msstore
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-17, RUN-01] Install or upgrade Microsoft Teams (personal)"
        securityContext: elevated
      settings:
        id: Microsoft.Teams.Free
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-19, RUN-01] Install or upgrade Obsidian"
        securityContext: elevated
      settings:
        id: Obsidian.Obsidian
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-20, RUN-01] Install or upgrade 7-Zip"
        securityContext: elevated
      settings:
        id: 7zip.7zip
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-21, RUN-01] Install or upgrade PowerToys"
        securityContext: elevated
      settings:
        id: Microsoft.PowerToys
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-22, RUN-01] Install or upgrade VLC media player"
        securityContext: elevated
      settings:
        id: VideoLAN.VLC
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-23, RUN-01] Install or upgrade Notepad++"
        securityContext: elevated
      settings:
        id: Notepad++.Notepad++
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-24, RUN-01] Install or upgrade WinDirStat"
        securityContext: elevated
      settings:
        id: WinDirStat.WinDirStat
        source: winget
        UseLatest: true
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-25] Remove Microsoft News"
        securityContext: elevated
      settings:
        id: 9WZDNCRFHVFW
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-26] Remove MSN Weather"
        securityContext: elevated
      settings:
        id: 9WZDNCRFJ3Q2
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-27] Remove Widgets board (Windows Web Experience Pack)"
        securityContext: elevated
      settings:
        id: 9MSSGKG348SP
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-28] Remove Microsoft Bing"
        securityContext: elevated
      settings:
        id: 9NZBF4GT040C
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-29] Remove Phone Link"
        securityContext: elevated
      settings:
        id: 9NMPJ99VJBWV
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-30] Remove Feedback Hub"
        securityContext: elevated
      settings:
        id: 9NBLGGH4R32N
        source: msstore
        Ensure: Absent
    - resource: Microsoft.WinGet.DSC/WinGetPackage
      directives:
        description: "[APP-31] Remove Microsoft Family Safety"
        securityContext: elevated
      settings:
        id: 9PDJDJS743XF
        source: msstore
        Ensure: Absent
    - resource: Microsoft.Windows.Developer/EnableDarkMode
      directives:
        description: "[SET-01] Dark mode for Windows and apps"
        allowPrerelease: true
      settings:
        Ensure: Present
    - resource: Microsoft.Windows.Developer/Taskbar
      directives:
        description: "[SET-02] Center the taskbar icons"
        allowPrerelease: true
      settings:
        Alignment: Middle
    - resource: Microsoft.Windows.Developer/Taskbar
      directives:
        description: "[SET-03] Hide the Widgets button on the taskbar"
        allowPrerelease: true
      settings:
        WidgetsButton: Hide
    - resource: Microsoft.Windows.Developer/Taskbar
      directives:
        description: "[SET-04] Hide the Task View button on the taskbar"
        allowPrerelease: true
      settings:
        TaskViewButton: Hide
    - resource: Microsoft.Windows.Developer/ShowSecondsInClock
      directives:
        description: "[SET-05] Show seconds in the taskbar clock"
        allowPrerelease: true
      settings:
        Ensure: Present
    - resource: Microsoft.Windows.Developer/WindowsExplorer
      directives:
        description: "[SET-06] Show file extensions in File Explorer"
        allowPrerelease: true
      settings:
        FileExtensions: Show
    - resource: Microsoft.Windows.Developer/WindowsExplorer
      directives:
        description: "[SET-07] Show hidden files and folders in File Explorer"
        allowPrerelease: true
      settings:
        HiddenFiles: Show
    - resource: Microsoft.Windows.Developer/WindowsExplorer
      directives:
        description: "[SET-08] Show item checkboxes in File Explorer"
        allowPrerelease: true
      settings:
        ItemCheckBoxes: Show
  configurationVersion: 0.2.0
